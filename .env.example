# ============================================================
# GSEA Dashboard - Environment Configuration Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME="GSEA Dashboard"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Frontend
# Note: Streamlit's own port is set via the --server.port CLI flag when
# running `streamlit run app.py`, not read from this file by the backend.
STREAMLIT_PORT=8501

# Database
# Must use the async driver scheme (sqlite+aiosqlite://), not plain sqlite://
# — this codebase uses SQLAlchemy's async engine throughout.
DATABASE_URL=sqlite+aiosqlite:///./data/gsea.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gsea_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Electricity Maps API (optional - for carbon intensity data)
ELECTRICITY_MAPS_API_KEY=your-api-key-here

# NLP Model paths
SPACY_MODEL=en_core_web_sm
HF_MODEL=distilbert-base-uncased

# Data upload limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=csv,json,xlsx
