# ============================================================
# GSEA Dashboard - .gitignore
# ============================================================

# Environment
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Data (exclude sensitive user data; keep sample data)
data/uploads/*
data/processed/*
!data/uploads/.gitkeep
!data/processed/.gitkeep

# Exports
exports/*
!exports/.gitkeep

# NLP models (large files)
nlp/models/*
!nlp/models/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Database
*.db
*.sqlite3
*.sqlite

# Logs
logs/
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb
