# .streamlit/secrets.toml — Streamlit Community Cloud secrets
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to version control — it is in .gitignore.
#
# On Streamlit Community Cloud:
#   App Settings → Secrets → paste this content

[app]
app_name = "GSEA Dashboard"
debug = false

[api]
base_url = "http://localhost:8000"

[database]
# Use SQLite for Streamlit Cloud (no external DB needed for prototype)
# Must use the async driver scheme — see backend/config.py's default.
database_url = "sqlite+aiosqlite:///./data/gsea.db"

[electricity_maps]
# Optional: get a free API key at https://api.electricitymap.org
api_key = ""

[nlp]
spacy_model = "en_core_web_sm"
hf_model = "distilbert-base-uncased"
